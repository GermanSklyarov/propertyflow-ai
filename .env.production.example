NODE_ENV=production

# Public ports exposed by the application containers.
WEB_PORT=3000
AGENCY_PORT=3002
ADMIN_PORT=3003
API_PORT=3001

# Internal data-store credentials. Use strong unique values in production.
POSTGRES_USER=propertyflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=propertyflow
MINIO_ROOT_USER=propertyflow
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Application secrets. Use long random values and keep this file out of git.
PROPERTYFLOW_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
PROPERTYFLOW_ADMIN_KEY=replace-with-a-long-random-admin-key
PROPERTYFLOW_ALLOW_DEV_AUTH_HEADERS=false
PROPERTYFLOW_TENANT_ID=demo-agency
PROPERTYFLOW_BOOTSTRAP_LOGIN_CODE=
PROPERTYFLOW_BOOTSTRAP_USER_ID=manager-demo-1

# Public URLs used in generated links and client-side calls.
PROPERTYFLOW_API_PUBLIC_URL=http://localhost:3001
PROPERTYFLOW_API_URL=http://api:3001
NEXT_PUBLIC_PROPERTYFLOW_API_URL=http://localhost:3001
NEXT_PUBLIC_PROPERTYFLOW_WEB_URL=http://localhost:3000
AGENCY_APP_BASE_URL=http://localhost:3002

# Optional external providers.
PROPERTYFLOW_EMAIL_FROM=
RESEND_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_CHAT_MODEL=
AI_CHAT_TIMEOUT_MS=8000
AI_CHAT_MAX_OUTPUT_TOKENS=1400
AI_ALLOW_DETERMINISTIC_CHAT_FALLBACK=false
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
OPENROUTER_API_KEY=
MAP_GEOCODING_PROVIDER=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
