NODE_ENV=development
APP_PORT=3000
API_PORT=3001
ADMIN_PORT=3002

PROPERTYFLOW_ACCESS_TOKEN_SECRET=change-me-for-local-development
PROPERTYFLOW_ALLOW_DEV_AUTH_HEADERS=false
PROPERTYFLOW_BOOTSTRAP_LOGIN_CODE=
PROPERTYFLOW_BOOTSTRAP_USER_ID=manager-demo-1

DATABASE_URL=postgresql://propertyflow:propertyflow@localhost:5432/propertyflow
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=propertyflow
S3_SECRET_KEY=propertyflow-secret
S3_BUCKET=propertyflow-assets

AI_DEFAULT_PROVIDER=openai
AI_CHAT_MODEL=
AI_ALLOW_DETERMINISTIC_CHAT_FALLBACK=false
# Leave blank for automatic provider selection: Gemini when GEMINI_API_KEY is set,
# OpenAI when OPENAI_API_KEY is set, otherwise local-hash for offline development.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
OPENROUTER_API_KEY=
